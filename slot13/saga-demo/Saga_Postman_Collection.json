{
  "info": {
    "name": "MSS301 - Saga Demo (Spring Boot 4.1.1)",
    "description": "Order Saga (Orchestration): order-service (MySQL), inventory-service (MongoDB), payment-service (SQL Server). Chạy Runner theo thứ tự 0 -> KB1 -> KB2 -> KB3 -> KB4 -> KB5 -> KB7, bỏ chọn thư mục Thủ công.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0 - Kiểm tra service",
      "item": [
        {
          "name": "Danh sách sản phẩm",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{inventoryUrl}}/api/inventory/products"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const ids = pm.response.json().map(p => p.id);",
                  "pm.test(\"Có sản phẩm P1, P2\", () => pm.expect(ids).to.include.members([\"P1\", \"P2\"]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Danh sách ví",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{paymentUrl}}/api/payments/wallets"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const ids = pm.response.json().map(w => w.customerId);",
                  "pm.test(\"Có ví C1, C2\", () => pm.expect(ids).to.include.members([\"C1\", \"C2\"]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Danh sách order",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{orderUrl}}/api/orders"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Trả về mảng\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        }
      ]
